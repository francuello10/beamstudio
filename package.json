{
  "name": "beamstudio",
  "version": "1.0.0",
  "description": "Advanced DMX Light Controller via Art-Net",
  "main": "./out/main/index.js",
  "author": "Antigravity Team",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build": "electron-vite build && cp src/main/logger.cjs out/main/logger.cjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/generative-ai": "^0.24.1",
    "dmxnet": "^0.9.0",
    "ftdi-d2xx": "^1.3.1",
    "serialport": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.17",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "framer-motion": "^12.27.0",
    "lucide-react": "^0.562.0",
    "postcss": "^8.4.33",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.antigravity.dmx",
    "productName": "BeamStudio",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "README.md",
      "package.json"
    ],
    "extraMetadata": {
      "main": "./out/main/index.js"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Antigravity Team",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BeamStudio"
    },
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/ftdi-d2xx/**/*"
    ]
  }
}
