{
  "name": "beamstudio",
  "version": "1.0.0",
  "description": "Advanced DMX Light Controller via Art-Net",
  "main": "./out/main/index.js",
  "author": "Fran Cuello <francuello.1999@gmail.com> (https://github.com/francuello10)",
  "homepage": "https://github.com/francuello10/beamstudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/francuello10/beamstudio.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dmxnet": "^0.9.0",
    "ftdi-d2xx": "^1.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.4.0",
    "electron-vite": "^2.3.0",
    "framer-motion": "^12.27.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "com.francuello.beamstudio",
    "productName": "BeamStudio",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "README.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Fran Cuello <francuello.1999@gmail.com>",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BeamStudio"
    }
  }
}