{
  "name": "beamstudio",
  "version": "1.0.0",
  "description": "Advanced DMX Light Controller — Art-Net, USB Direct, Ambilight, Audio Reactive",
  "main": "./out/main/index.js",
  "author": "Fran Cuello <francuello.1999@gmail.com> (https://github.com/francuello10)",
  "homepage": "https://github.com/francuello10/beamstudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/francuello10/beamstudio.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/generative-ai": "^0.24.1",
    "dmxnet": "^0.9.0",
    "ftdi-d2xx": "^1.3.1",
    "serialport": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.4.0",
    "electron-vite": "^2.3.0",
    "framer-motion": "^12.27.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "com.francuello.beamstudio",
    "productName": "BeamStudio",
    "copyright": "Copyright © 2026 Fran Cuello",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "README.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Fran Cuello <francuello.1999@gmail.com>",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BeamStudio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}